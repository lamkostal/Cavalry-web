{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cavalry-web",
  "main": "src/entry.py",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "API_HOST": "example.com"
  }
}
